                    <div class="section-title">Luxury <span>Car Fleet</span></div>
                </div>
            </div>
            <div class="cars1-carousel owl-theme owl-carousel">
              
                <% for(var i=0; i<cars.length; i++) { %>

                <div class="item">
                    <div class="img"> <img height="20" src="img/cars/<%= cars[i].carID %>/00.png" alt=""> </div>
                    <div class="con opacity-1">
                        <div class="row">
                            <div class="col-md-7">
                                <div class="title"><a href="#"><%= cars[i].name %></a></div>
                                <div class="details"> <span><i class="omfi-door"></i> <%= cars[i].seats %> Seats</span> <span><i class="omfi-transmission"></i> <%= cars[i].gear %></span> <span><i class="omfi-luggage"></i> <%= cars[i].year %></span> </div>
                            </div>
                            <div class="col-md-5">
                                <div class="book">
                                    <div><a href="/car-details/<%= cars[i].carID %>" class="btn"><span>Details</span></a></div>
                                    <!-- <div><span class="price">$750</span><span>/day</span></div> -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <% } %>
               
             
               
               
                
                
                
